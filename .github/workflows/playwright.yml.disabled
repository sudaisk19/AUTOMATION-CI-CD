# ⚠️ DISABLED — this pipeline has been replaced by Jenkins.
#
# GitHub Actions only picks up *.yml / *.yaml inside .github/workflows/,
# so the .disabled extension keeps this file as reference without running it.
#
# To re-enable:  mv playwright.yml.disabled playwright.yml

name: OrangeHRM E2E

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

jobs:
  e2e:
    timeout-minutes: 25
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
          cache-dependency-path: package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Configure environment
        run: cp .env.example .env

      - name: Install Playwright Chromium
        run: npx playwright install chromium --with-deps

      - name: Run E2E tests
        run: npm run test:ci
        env:
          CI: true

      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: playwright-report
          path: playwright-report/
          retention-days: 7
